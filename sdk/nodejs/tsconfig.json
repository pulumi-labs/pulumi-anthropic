{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "agents/agent.ts",
        "agents/deployment.ts",
        "agents/environment.ts",
        "agents/index.ts",
        "agents/memoryStore.ts",
        "agents/tunnel.ts",
        "agents/tunnelCertificate.ts",
        "agents/userProfile.ts",
        "agents/vault.ts",
        "agents/vaultCredential.ts",
        "config/index.ts",
        "config/vars.ts",
        "getModels.ts",
        "getOrganization.ts",
        "getRateLimits.ts",
        "identity/federationIssuer.ts",
        "identity/federationRule.ts",
        "identity/federationRuleWorkspace.ts",
        "identity/index.ts",
        "identity/rbacGroup.ts",
        "identity/rbacGroupMember.ts",
        "identity/serviceAccount.ts",
        "identity/serviceAccountWorkspace.ts",
        "index.ts",
        "organization/apiKey.ts",
        "organization/complianceSettings.ts",
        "organization/index.ts",
        "organization/invite.ts",
        "organization/spendLimit.ts",
        "organization/user.ts",
        "organization/workspace.ts",
        "organization/workspaceMember.ts",
        "provider.ts",
        "security/externalKey.ts",
        "security/index.ts",
        "skills/index.ts",
        "skills/skill.ts",
        "types/enums/agents/index.ts",
        "types/enums/identity/index.ts",
        "types/enums/index.ts",
        "types/enums/organization/index.ts",
        "types/enums/security/index.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
